# =========================
# ARIS Environment Template
# =========================

# --- Core ---
ENV=development
ARIS_LOG_LEVEL=INFO

# --- OpenAI ---
# Put your real key here (never commit real .env)
OPENAI_API_KEY=sk-REPLACE_WITH_REAL_KEY
OPENAI_MODEL=gpt-4.1-mini

# --- JWT / Auth ---
# Must be long (>=32 chars recommended)
ARIS_JWT_SECRET=change-this-to-a-long-random-32-plus-char-secret
ARIS_JWT_ALG=HS256
ARIS_JWT_EXPIRE_MIN=60

# --- Rate Limiting ---
ARIS_RATE_LIMIT_REQUESTS=30
ARIS_RATE_LIMIT_WINDOW_SEC=60

# --- App / API ---
HOST=0.0.0.0
PORT=8000

# --- Database / Queue (if used) ---
DATABASE_URL=sqlite:///./data/aris.db

# --- Twilio (optional) ---
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
USER_PHONE_NUMBER=

# --- Google Calendar (optional) ---
GOOGLE_CALENDAR_ENABLED=false
GOOGLE_CALENDAR_ID=primary
GOOGLE_CREDENTIALS_PATH=/app/credentials/google_credentials.json
GOOGLE_TOKEN_PATH=/app/credentials/token.json