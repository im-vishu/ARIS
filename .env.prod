APP_ENV=prod
LOG_LEVEL=INFO
DEBUG=false

JWT_SECRET=replace-with-very-long-random-secret-32-plus
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_MIN=10080

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

OPENAI_API_KEY=replace-with-real-prod-key
REDIS_URL=redis://redis-prod:6379/0
DATABASE_URL=postgresql+psycopg2://aris:***@postgres-prod:5432/aris

CORS_ORIGINS=https://yourapp.com,https://admin.yourapp.com
ALLOWED_HOSTS=yourapp.com,api.yourapp.com
DB_POOL_SIZE=15
DB_MAX_OVERFLOW=30