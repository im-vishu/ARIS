APP_ENV=prod
LOG_LEVEL=INFO

# Security
JWT_SECRET=prod-secret-must-be-long-random-32-plus-chars
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=15
REFRESH_TOKEN_EXPIRE_MIN=10080

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=60

# Integrations
OPENAI_API_KEY=sk-prod-placeholder
REDIS_URL=redis://aris-redis:6379/0

# Database (prod postgres)
DATABASE_URL=postgresql+psycopg2://aris:aris@postgres:5432/aris