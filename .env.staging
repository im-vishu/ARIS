APP_ENV=staging
LOG_LEVEL=INFO

# Security
JWT_SECRET=staging-secret-change-this-to-32-plus-chars
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_MIN=10080

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

# Integrations
OPENAI_API_KEY=sk-staging-placeholder
REDIS_URL=redis://aris-redis:6379/0

# Database (staging postgres)
DATABASE_URL=postgresql+psycopg2://aris:aris@postgres:5432/aris