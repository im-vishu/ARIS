APP_ENV=dev
LOG_LEVEL=INFO
DEBUG=false

JWT_SECRET=dev-secret-change-this-to-32-plus-chars-minimum
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_MIN=10080

RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=20

OPENAI_API_KEY=sk-dev-placeholder
REDIS_URL=redis://aris-redis:6379/0
DATABASE_URL=postgresql+psycopg2://aris:aris@postgres:5432/aris

CORS_ORIGINS=*
ALLOWED_HOSTS=*
DB_POOL_SIZE=5
DB_MAX_OVERFLOW=10