APP_ENV=dev
LOG_LEVEL=INFO

# Security
JWT_SECRET=dev-secret-change-this-to-32-plus-chars
JWT_ALG=HS256
ACCESS_TOKEN_EXPIRE_MIN=30
REFRESH_TOKEN_EXPIRE_MIN=10080

# Rate limiting
RATE_LIMIT_ENABLED=true
RATE_LIMIT_PER_MINUTE=10

# Integrations
OPENAI_API_KEY=sk-dev-placeholder
REDIS_URL=redis://aris-redis:6379/0

# Database (local sqlite)
DATABASE_URL=sqlite:///./aris.db